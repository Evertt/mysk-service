{
	"$schema": "https://inlang.com/schema/inlang-message-format",
	"dashboard_title": "Dashboard",
	"dashboard_open_orders": "Open orders",
	"dashboard_without_engineer": "{count} without an engineer",
	"dashboard_urgent": "Urgent",
	"dashboard_urgent_description": "Open orders with urgent priority",
	"dashboard_revenue": "Revenue, last 30 days",
	"dashboard_revenue_orders": [
		{
			"declarations": [
				"input count",
				"local countPlural = count: plural",
				"local countText = count: number"
			],
			"selectors": ["countPlural"],
			"match": {
				"countPlural=one": "From {countText} completed order",
				"countPlural=*": "From {countText} completed orders"
			}
		}
	],
	"dashboard_attention": "Equipment needing attention",
	"dashboard_attention_of": [
		{
			"declarations": [
				"input count",
				"local countPlural = count: plural",
				"local countText = count: number"
			],
			"selectors": ["countPlural"],
			"match": {
				"countPlural=one": "Of {countText} installed unit",
				"countPlural=*": "Of {countText} installed units"
			}
		}
	],
	"dashboard_orders_per_week": "Orders per week",
	"dashboard_orders_per_week_description": "New orders in the last 12 weeks, by their status now.",
	"dashboard_revenue_per_month": "Revenue per month",
	"dashboard_revenue_per_month_description": "Work completed in the last 12 months, priced like the revenue tile.",
	"dashboard_equipment_by_status": "Equipment by status",
	"dashboard_equipment_by_status_description": "The installed units and how they are doing.",
	"dashboard_column_week": "Week",
	"dashboard_column_month": "Month",
	"dashboard_column_status": "Status",
	"dashboard_column_units": "Units",
	"dashboard_column_revenue": "Revenue",
	"dashboard_column_completed_orders": "Completed orders",
	"dashboard_upcoming": "Upcoming work",
	"dashboard_upcoming_description": "The next scheduled orders.",
	"dashboard_all_orders": "All orders",
	"dashboard_column_order": "Order",
	"dashboard_column_customer": "Customer",
	"dashboard_column_equipment": "Equipment",
	"dashboard_new_installation": "New installation",
	"dashboard_column_engineer": "Engineer",
	"dashboard_column_priority": "Priority",
	"dashboard_column_scheduled": "Scheduled",
	"dashboard_awaiting_acceptance": "Awaiting acceptance",
	"dashboard_awaiting_acceptance_description": "Reported by customers in their portal",
	"dashboard_awaiting_acceptance_show": "Show",
	"dashboard_greeting_morning": "Good morning, {name}",
	"dashboard_greeting_afternoon": "Good afternoon, {name}",
	"dashboard_greeting_evening": "Good evening, {name}",
	"dashboard_greeting_line": "Here's what's happening today.",
	"dashboard_trend_made": "{count} new in the last 7 days ({change})",
	"dashboard_trend_revenue": "{change} on the 30 days before"
}
