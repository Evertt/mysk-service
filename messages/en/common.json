	"common_table_rows": [
		{
			"declarations": [
				"input count",
				"local countPlural = count: plural",
				"local countText = count: number"
			],
			"selectors": ["countPlural"],
			"match": {
				"countPlural=one": "{countText} row",
				"countPlural=*": "{countText} rows"
			}
		}
	],
	"common_table_rows_selected": [
		{
			"declarations": [
				"input count",
				"local countPlural = count: plural",
				"local countText = count: number"
			],
			"selectors": ["countPlural"],
			"match": {
				"countPlural=one": "{selected} of {countText} row selected",
				"countPlural=*": "{selected} of {countText} rows selected"
			}
		}
	],
