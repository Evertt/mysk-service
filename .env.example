# Drizzle
DATABASE_URL=file:local.db

# The public URL of the app, e.g. http://localhost:5173 in development or
# https://fieldworks.example.com in production. Used for sign-in and for links in emails.
ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Mail (optional). Without SMTP_URL, mail such as invitations is logged to the server console.
# SMTP_URL="smtps://user:password@smtp.example.com:465"
# MAIL_FROM="Fieldworks <noreply@example.com>"
