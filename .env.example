# Drizzle: a local file, or a Turso database (libsql://<name>.turso.io) with its access token
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=""

# The public URL of the app: http://localhost:5173 in development (the default here), or e.g.
# https://fieldworks.example.com in production. Better Auth's base URL (sign-in, callbacks) and
# the links in emails. The end-to-end tests set their own servers' origin.
ORIGIN="http://localhost:5173"

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Demo sign-in: `true` shows the login page's Planner, Engineer and Customer buttons, which sign in
# as the seeded SHLTR demo users without a password, and the user menus' "View as", which switches
# between them (README "Demo login"). For local and staging demos only: uncomment it in your own
# `.env`, never in a real deployment. Off when unset.
# DEMO_SIGN_IN=true

# Mail (optional). Without SMTP_URL, mail such as invitations is logged to the server console.
# SMTP_URL="smtp://user:password@smtp.example.com:587"
# MAIL_FROM="Fieldworks <noreply@example.com>"

# Bug reports (the record button in the office's and the engineer portal's headers). Who gets a
# mail for each one (without it, the mail is logged to the server console), and the developers who
# may open them at /ops/bug-reports, by their accounts' email addresses, comma-separated (without
# it, no one may). Off Cloudflare (whose recordings go to the BUG_REPORTS R2 bucket), the folder
# the recordings are stored in, `.bug-reports` by default.
# BUG_REPORT_EMAIL="bugs@example.com"
# DEVELOPER_EMAILS="you@example.com"
# BUG_REPORTS_DIR=".bug-reports"
