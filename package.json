{
	"name": "svadcn-themed",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"sideEffects": [
		"*.css",
		"./.svelte-kit/output/**"
	],
	"imports": {
		"#kit-worker": {
			"types": "./cloudflare/kit-worker.d.ts",
			"default": "./.svelte-kit/cloudflare/_worker.js"
		},
		"#lib/*": "./src/lib/*",
		"#modules/*": "./src/modules/*",
		"#routes/*": "./src/routes/*",
		"#clock/*": "./src/tests/clock/*",
		"#e2e/*": "./src/tests/e2e/*",
		"#unit/*": "./src/tests/unit/*",
		"#ui/*": "./src/lib/components/ui/*/index.ts"
	},
	"scripts": {
		"dev": "vp dev",
		"build": "vp build",
		"preview": "vp preview",
		"build:cloudflare": "ADAPTER=cloudflare vp build",
		"dev:cloudflare": "ADAPTER=cloudflare vp build && wrangler dev",
		"deploy:cloudflare": "ADAPTER=cloudflare vp build && wrangler deploy",
		"types:cloudflare": "wrangler types --env-file=.dev.vars.example cloudflare/worker-configuration.d.ts",
		"prepare": "node scripts/prepare.ts",
		"generate": "node scripts/generate.ts",
		"check": "vpr generate && vp check && svelte-check && tsc -p cloudflare",
		"check:watch": "vpr check --watch",
		"test:unit": "vp test --project 'server-*' --project client",
		"test:e2e": "vp test run --project e2e",
		"test": "node scripts/test.ts",
		"db:generate": "node scripts/db-generate.ts",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "auth generate --config src/lib/server/auth/better-auth.ts --output src/lib/server/db/auth.schema.ts --yes",
		"db:seed": "node --env-file=.env src/lib/server/db/seed/index.ts",
		"org:create": "node --env-file=.env src/lib/server/db/create-organization.ts",
		"db:reset": "node --env-file-if-exists=.env scripts/db-reset.ts",
		"jobs:daily": "node --env-file-if-exists=.env scripts/daily.ts",
		"docks:simulate": "node scripts/docks-simulator.ts",
		"themes:sync": "node scripts/theme-components.ts && vp check --fix",
		"knip": "knip"
	},
	"dependencies": {
		"@libsql/client": "^0.17.4",
		"@rrweb/record": "2.1.7",
		"@rrweb/rrweb-plugin-console-record": "2.1.7",
		"lean-qr": "2.7.4",
		"rrweb-player": "2.1.7",
		"temporal-polyfill": "1.0.5"
	},
	"devDependencies": {
		"@faker-js/faker": "^10.6.0",
		"@fontsource-variable/ibm-plex-sans": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/nunito": "^5.3.0",
		"@fontsource-variable/space-grotesk": "^5.3.0",
		"@inlang/paraglide-js": "^2.18.2",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.52.0",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@tanstack/svelte-table": "^9.2.5",
		"@types/node": "^24",
		"@types/nodemailer": "^8.0.2",
		"@vitest/browser-playwright": "catalog:",
		"auth": "^1.6.24",
		"better-auth": "^1.6.24",
		"bits-ui": "^2.19.5",
		"cn": "^0.4.0",
		"devalue": "5.9.4",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"knip": "^6.40.0",
		"layerchart": "^2.5.2",
		"nodemailer": "^10.0.15",
		"pdf-lib": "^1.17.1",
		"playwright": "^1.60.0",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"svelte-sonner": "^1.2.1",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "~6.0.3",
		"unplugin-auto-import": "^21.1.0",
		"valibot": "^1.5.0",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:",
		"vitest-browser-svelte": "^2.1.1",
		"wrangler": "4.151.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.9.1",
			"onFail": "download"
		}
	},
	"packageManager": "pnpm@12.9.1"
}
