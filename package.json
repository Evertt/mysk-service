{
  "name": "svadcn-themed",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "prepare": "vp config && vpr generate || echo ''",
    "generate": "node -e \"fs.rmSync('.svelte-kit/.svelte-check', { recursive: true, force: true })\" && svelte-kit sync &&paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie preferredLanguage baseLocale --emit-ts-declarations --silent",
    "check": "vpr generate && vp check && svelte-check --tsgo --tsconfig ./tsconfig.json",
    "check:watch": "vpr check --watch",
    "test:unit": "vp test",
    "test": "npm run test:unit -- --run",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "auth:schema": "auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.18.2",
    "@libsql/client": "^0.17.3",
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24",
    "@typescript/native": "npm:typescript@7",
    "@vitest/browser-playwright": "catalog:",
    "auth": "^1.6.24",
    "better-auth": "^1.6.24",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "playwright": "^1.60.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-svelte": "^2.1.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.1",
      "onFail": "download"
    }
  }
}
