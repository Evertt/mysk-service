	"partners_dashboard_description": [
		{
			"declarations": [
				"input count",
				"local countPlural = count: plural",
				"local countText = count: number"
			],
			"selectors": ["countPlural"],
			"match": {
				"countPlural=one": "{countText} partner, by the level reached so far",
				"countPlural=*": "{countText} partners, by the level reached so far"
			}
		}
	],
	"partners_close_partners": [
		{
			"declarations": [
				"input count",
				"local countPlural = count: plural",
				"local countText = count: number"
			],
			"selectors": ["countPlural"],
			"match": {
				"countPlural=one": "{countText} partner",
				"countPlural=*": "{countText} partners"
			}
		}
	],
	"partners_close_open": [
		{
			"declarations": [
				"input count",
				"input cash",
				"input credit",
				"local countPlural = count: plural",
				"local countText = count: number"
			],
			"selectors": ["countPlural"],
			"match": {
				"countPlural=one": "{countText} still to close: cash {cash} or credit {credit} in all",
				"countPlural=*": "{countText} still to close: cash {cash} or credit {credit} in all"
			}
		}
	],
	"partners_close_confirm_description": [
		{
			"declarations": [
				"input count",
				"local countPlural = count: plural",
				"local countText = count: number"
			],
			"selectors": ["countPlural"],
			"match": {
				"countPlural=one": "The figures of {countText} partner are frozen as they are now. This can't be undone.",
				"countPlural=*": "The figures of {countText} partners are frozen as they are now. This can't be undone."
			}
		}
