	"checklists_months": [
		{
			"declarations": [
				"input count",
				"local countPlural = count: plural",
				"local countText = count: number"
			],
			"selectors": ["countPlural"],
			"match": {
				"countPlural=one": "{countText} month",
				"countPlural=*": "{countText} months"
			}
		}
	],
	"checklists_count_points": [
		{
			"declarations": [
				"input count",
				"local countPlural = count: plural",
				"local countText = count: number"
			],
			"selectors": ["countPlural"],
			"match": {
				"countPlural=one": "{countText} point",
				"countPlural=*": "{countText} points"
			}
		}
	],
