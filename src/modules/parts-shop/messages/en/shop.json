	"shop_products_description": [
		{
			"declarations": [
				"input count",
				"local countPlural = count: plural",
				"local countText = count: number"
			],
			"selectors": ["countPlural"],
			"match": {
				"countPlural=one": "{countText} material in the customer portal's shop. Its price and stock are the material's.",
				"countPlural=*": "{countText} materials in the customer portal's shop. Their price and stock are the materials'."
			}
		}
	],
	"shop_checkpoint_count": [
		{
			"declarations": [
				"input count",
				"local countPlural = count: plural",
				"local countText = count: number"
			],
			"selectors": ["countPlural"],
			"match": {
				"countPlural=one": "{countText} point",
				"countPlural=*": "{countText} points"
			}
		}
	],
	"shop_category_products": [
