# Local secrets for `pnpm dev:cloudflare` (wrangler dev): copy to `.dev.vars`, which isn't committed.
BETTER_AUTH_SECRET=change-me-to-32-random-characters
OPS_TOKEN=change-me
ORIGIN=http://localhost:8787
# Optional: who is mailed about bug reports, and the developers who may open them (comma-separated).
# BUG_REPORT_EMAIL=bugs@example.com
# DEVELOPER_EMAILS=you@example.com
