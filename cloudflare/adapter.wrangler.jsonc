// SPIKE: the config SvelteKit's adapter reads, so that it writes its worker to `_worker.js`; the
// Worker that's deployed is `wrangler.jsonc`'s, whose entry wraps it (`entry.ts`).
{
	"name": "fieldworks-spike",
	"main": "../.svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": { "directory": "../.svelte-kit/cloudflare", "binding": "ASSETS" }
}
