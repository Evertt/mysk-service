// The app on Cloudflare: a Worker whose requests are answered by one Durable Object with the app's
// SQLite database (`cloudflare/entry.ts`). `pnpm deploy:cloudflare` builds and deploys it; secrets
// (`BETTER_AUTH_SECRET`, `OPS_TOKEN` for imports and the daily jobs, optionally `SMTP_URL`) are set with `wrangler secret put`, and
// locally in `.dev.vars` (see `.dev.vars.example`).
{
	"name": "fieldworks",
	"main": "cloudflare/entry.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": { "directory": ".svelte-kit/cloudflare", "binding": "ASSETS" },
	// The migrations' SQL, which `cloudflare/migrations/migrations.js` imports.
	"rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
	"durable_objects": { "bindings": [{ "name": "APP_DATABASE", "class_name": "AppDatabase" }] },
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["AppDatabase"] }],
	"vars": { "ORIGIN": "https://fieldworks.devign.workers.dev" },
	// The daily jobs (e.g. maintenance plans that become orders), at 04:00 UTC, and the demo's
	// simulations' tick, every minute: `scheduled()` in `cloudflare/entry.ts`. They need the
	// `OPS_TOKEN` secret.
	"triggers": { "crons": ["0 4 * * *", "* * * * *"] },
	"observability": { "enabled": true },
	"env": {
		// Staging, the deploy of `develop` (`wrangler deploy --env staging`, from CI): a Worker of its
		// own, `fieldworks-staging`, with its own Durable Object and so its own database, which CI fills
		// with the demo data on every deploy. Bindings and vars aren't inherited, so they're repeated.
		"staging": {
			"name": "fieldworks-staging",
			"durable_objects": { "bindings": [{ "name": "APP_DATABASE", "class_name": "AppDatabase" }] },
			"migrations": [{ "tag": "v1", "new_sqlite_classes": ["AppDatabase"] }],
			"vars": { "ORIGIN": "https://fieldworks-staging.devign.workers.dev" },
			"triggers": { "crons": ["0 4 * * *", "* * * * *"] },
		},
	},
}
