// SPIKE: the Worker, with one Durable Object (and SQLite database) per organization; see
// `cloudflare/entry.ts`.
{
	"name": "fieldworks-spike",
	"main": "cloudflare/entry.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": { "directory": ".svelte-kit/cloudflare", "binding": "ASSETS" },
	"rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
	"durable_objects": { "bindings": [{ "name": "TENANT", "class_name": "Tenant" }] },
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["Tenant"] }],
	"vars": { "DATABASE_URL": "durable-object", "ORIGIN": "http://localhost:8787" },
	"observability": { "enabled": true }
}
