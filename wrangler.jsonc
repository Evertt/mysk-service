// The app on Cloudflare: a Worker whose requests are answered by one Durable Object with the app's
// SQLite database (`cloudflare/entry.ts`). `pnpm deploy:cloudflare` builds and deploys it; secrets
// (`BETTER_AUTH_SECRET`, `OPS_TOKEN` for imports and the daily jobs, optionally `SMTP_URL`,
// `BUG_REPORT_EMAIL` and `DEVELOPER_EMAILS`) are set with `wrangler secret put`, and
// locally in `.dev.vars` (see `.dev.vars.example`). Mail goes out through `SMTP_URL` on port 587
// (STARTTLS), from `MAIL_FROM` in the vars: see "Mail on Cloudflare" in README.md.
{
	"name": "fieldworks",
	"main": "cloudflare/entry.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": { "directory": ".svelte-kit/cloudflare", "binding": "ASSETS" },
	// The migrations' SQL, which `cloudflare/migrations/migrations.js` imports.
	"rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
	"durable_objects": { "bindings": [{ "name": "APP_DATABASE", "class_name": "AppDatabase" }] },
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["AppDatabase"] }],
	// The recordings of bug reports (`src/lib/server/bug-reports/storage.ts`); made once with
	// `wrangler r2 bucket create fieldworks-bug-reports`.
	"r2_buckets": [{ "binding": "BUG_REPORTS", "bucket_name": "fieldworks-bug-reports" }],
	"vars": {
		"ORIGIN": "https://fieldworks.devign.workers.dev",
		"MAIL_FROM": "Fieldworks <noreply@devign.nl>",
	},
	// The daily jobs (e.g. maintenance plans that become orders), at 04:00 UTC, and the demo's
	// simulations' tick, every 15 minutes: `scheduled()` in `cloudflare/entry.ts`. They need the
	// `OPS_TOKEN` secret.
	"triggers": { "crons": ["0 4 * * *", "*/15 * * * *"] },
	// Workers Logs (the app's JSON lines, see "Reading the logs" in README.md, and a line per
	// invocation) and Cloudflare's automatic traces. `env.staging` inherits it (wrangler's
	// `observability` is inheritable, unlike bindings and vars).
	"observability": {
		"enabled": true,
		"logs": { "enabled": true, "invocation_logs": true },
		"traces": { "enabled": true },
	},
	"env": {
		// Staging, the deploy of `develop` (`wrangler deploy --env staging`, from CI): a Worker of its
		// own, `fieldworks-staging`, with its own Durable Object and so its own database, which CI fills
		// with the demo data on every deploy. Bindings and vars aren't inherited, so they're repeated.
		"staging": {
			"name": "fieldworks-staging",
			"durable_objects": { "bindings": [{ "name": "APP_DATABASE", "class_name": "AppDatabase" }] },
			"migrations": [{ "tag": "v1", "new_sqlite_classes": ["AppDatabase"] }],
			// `wrangler r2 bucket create fieldworks-staging-bug-reports`.
			"r2_buckets": [{ "binding": "BUG_REPORTS", "bucket_name": "fieldworks-staging-bug-reports" }],
			// `DEMO_SIGN_IN`: the login page's one-click demo sign-in (README "Demo login"), passwordless,
			// so here only, never in the top-level vars above (production). `TIMING_LOGS`: a timing line
			// per request (`src/lib/server/logs/timing.ts`), here only, so production's log volume stays known.
			"vars": {
				"ORIGIN": "https://fieldworks-staging.devign.workers.dev",
				"MAIL_FROM": "Fieldworks (staging) <noreply@devign.nl>",
				"DEMO_SIGN_IN": "true",
				"TIMING_LOGS": "1",
			},
			"triggers": { "crons": ["0 4 * * *", "*/15 * * * *"] },
		},
	},
}
