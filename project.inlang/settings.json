{
	"$schema": "https://inlang.com/schema/project-settings",
	"modules": [
		"https://cdn.jsdelivr.net/npm/@inlang/plugin-message-format@4/dist/index.js",
		"https://cdn.jsdelivr.net/npm/@inlang/plugin-m-function-matcher@2/dist/index.js"
	],
	"plugin.inlang.messageFormat": {
		"pathPattern": [
			"./messages/{locale}/common.json",
			"./messages/{locale}/enum.json",
			"./messages/{locale}/validation.json",
			"./messages/{locale}/auth.json",
			"./messages/{locale}/dashboard.json",
			"./messages/{locale}/orders.json",
			"./messages/{locale}/customers.json",
			"./messages/{locale}/equipment.json",
			"./messages/{locale}/engineers.json",
			"./messages/{locale}/materials.json",
			"./messages/{locale}/settings.json",
			"./messages/{locale}/portal.json",
			"./messages/{locale}/activity.json",
			"./src/modules/contracts/messages/{locale}/contracts.json",
			"./src/modules/invoicing/messages/{locale}/invoices.json",
			"./src/modules/maintenance/messages/{locale}/maintenance.json",
			"./src/modules/schedule/messages/{locale}/schedule.json"
		]
	},
	"baseLocale": "en",
	"locales": ["en", "nl"]
}
